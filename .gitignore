# Terraform state: never commit it, it can contain secrets
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*

# Local provider downloads and module cache
.terraform/
terraform-provider-*

# NOTE: .terraform.lock.hcl is intentionally NOT ignored.
# Commit it so every environment and CI run uses the same provider versions.

# Variable files: real values are ignored by default...
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
terraform.tfvars
terraform.tfvars.json
# ...except the per-environment value files, which are committed on purpose.
# Keep ONLY non-secret values in layered/envs/*.tfvars (use TF_VAR_* environment variables for secrets).
!layered/envs/*.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash log files
crash.log
crash.*.log

# Ignore CLI configuration files
.terraformrc
terraform.rc

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Log files
*.log

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Environment files that might contain secrets
.env
.env.local
.env.*.local

# Kubernetes config files that might contain sensitive data
kubeconfig
*.kubeconfig
